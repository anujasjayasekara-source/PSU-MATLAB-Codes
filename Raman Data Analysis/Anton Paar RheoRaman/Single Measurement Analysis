        'Position',[1 1 8 6], ...
        'Color','w');

    ax = axes(Figure_3D);
    hold(ax,'on');
    box(ax,'off');
    view(ax,3);

for i = 1:numel(Raman_SingleMeasurement)

    x = Raman_SingleMeasurement(i).Data(:,1);      % Raman shift
    z = Raman_SingleMeasurement(i).Data(:,4);      % Intensity
    y = Raman_SingleMeasurement(i).Temperature;    % Temperature

    surface([x x], ...
            [y*ones(size(x)) y*ones(size(x))], ...
            [z z], ...
            [z z], ...
            'FaceColor','none', ...
            'EdgeColor','interp', ...
            'LineWidth',2);

end

xlabel('Raman Shift (cm^{-1})'); xlim([500 2300]);
ylabel('Temperature (^{\circ}C)'); ylim([40 160]);
zlabel('Intensity'); zticks([]);
view(gca,20,50); grid('off'); set(gca, 'fontsize', 15)

clim(ax,[-0.8 5])
colormap(turbo)

savefig(Figure_3D, FigName + '_TempControl_3D.fig')
